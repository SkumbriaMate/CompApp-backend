# =============================================================================
# CompApp BACKEND — copy to .env (local) or paste into Railway Variables (staging)
# NEVER commit real .env to git. NEVER put these in Vercel (frontend).
# =============================================================================

PORT=4000
NODE_ENV=development
# Railway staging/production: NODE_ENV=production

# -----------------------------------------------------------------------------
# Supabase — Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-never-share

# -----------------------------------------------------------------------------
# WhatsApp — Meta → CompApp → WhatsApp → API Setup
# -----------------------------------------------------------------------------
# Phone number ID (long number under "From" test number)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Temporary token (24h) or permanent System User token later
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx

# WhatsApp Business Account ID (top of API Setup page)
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345

# YOU invent this string — same value in Meta → WhatsApp → Configuration → Verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=compapp-staging-verify-secret-change-me

# -----------------------------------------------------------------------------
# Frontend URL — CORS + invite links
# -----------------------------------------------------------------------------
# Local dev:
FRONTEND_URL=http://localhost:3000
# Railway staging (after Vercel deploy):
# FRONTEND_URL=https://comp-app-staging.vercel.app

# -----------------------------------------------------------------------------
# Email — Gmail
# Railway Hobby blocks SMTP (ports 465/587). Use Gmail API below OR Railway Pro.
# -----------------------------------------------------------------------------

# Option A — Gmail API (works on Railway Hobby, still your Gmail account)
# 1. console.cloud.google.com → project → enable Gmail API
# 2. OAuth client (Desktop) → copy client id + secret
# 3. OAuth Playground → scope gmail.send → get refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=your@gmail.com

# Option B — Gmail SMTP (works locally + Railway Pro only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# -----------------------------------------------------------------------------
# Auth (defaults are fine)
# -----------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
DRAFT_EXPIRY_HOURS=24
SESSION_DAYS=7
